---
import { Image } from 'astro:assets';

const {
  t,
  classes,
  title,
  description,
  description_more,
  img,
  alt,
  url,
  readme,
  preview,
  repo_visibility,
  badges,
  more_info,
  order,
} = Astro.props;

type Paragraph = {
  title: string;
  text: string;
};
---

<div
    class={`large-card ${classes || ''}`}
    data-order-featured={order?.featured}
    data-order-webapp={order?.webapp}
    data-order-data={order?.data}
    data-order-website={order?.website}
  >
    <div class="large-content">
    <Image src={img} alt={alt} loading="lazy" />
    <div class="projtext">
      <h4>{title}</h4>
      {
        badges && badges.length > 0 && (
          <div class="badges">
            {badges.map((tech: string) => (
              <span class={`badge ${tech.toLowerCase().replace(/\s+/g, '-')}`}>
                {tech.toUpperCase()}
              </span>
            ))}
          </div>
        )
      }
      <p set:html={description} />
    </div>
    <div class="third-area">
      {description_more && <p set:html={description_more} />}
      <div class="btncontfull">
        {
          preview && (
            <a
              href={url || '#'}
              class={`btn orange ${!url ? 'disabled' : ''}`}
              target="_blank"
              rel="noopener"
            >
              {t('project.visit')}
            </a>
          )
        }
        {
          repo_visibility && (
            <a
              href={readme}
              target="_blank"
              rel="noopener"
              class="btn2 icon-btn"
            >
              <i class="fa-brands fa-github fa-sm" />
              <span>GitHub</span>
            </a>
          )
        }
        {
          more_info && (
            <button
              class="btn-ghost more-info-btn icon-btn"
              aria-expanded="false"
            >
              <i class="fa-solid fa-arrow-down" />
              <span class="label-more">{t('project.discover-more')}</span>
              <span class="label-less">{t('project.discover-less')}</span>
            </button>
          )
        }
      </div>
    </div>
  </div>
  <div class="accordion">
    <div class="more-info">
      {
        more_info &&
          more_info.map((par: Paragraph) => (
            <p style="margin-bottom: 1rem;">
              <strong style="display:block; margin-bottom: 0.2rem;">
                {par.title}
              </strong>
              <span set:html={par.text} />
            </p>
          ))
      }
    </div>
  </div>
</div>
